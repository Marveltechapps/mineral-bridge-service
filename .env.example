NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB: `docker compose up -d mongo` starts a single-node replica set (required for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/mineralbridge?directConnection=true

# JWT / session secrets (generate strong random values; never commit real secrets)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
ADMIN_SESSION_SECRET=change-me-admin-session-secret-min-32!
WS_TOKEN_SECRET=change-me-ws-token-secret-min-32-chars!

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
MOBILE_REFRESH_TTL_SECONDS=5184000
WEB_REFRESH_TTL_SECONDS=2592000
ADMIN_IDLE_TIMEOUT_SECONDS=1800
ADMIN_ABSOLUTE_TTL_SECONDS=43200
REFRESH_REUSE_GRACE_SECONDS=10

# CORS allowlists (comma-separated origins)
CORS_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ADMIN_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_MOBILE_ORIGINS=

# Cookies
COOKIE_SECURE=false
WEB_REFRESH_COOKIE_NAME=mb_refresh
ADMIN_SESSION_COOKIE_NAME=mb_admin_session

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_SIGNED_URL_TTL_SECONDS=900
# S3 (production)
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# OTP provider (fake | twilio | africastalking)
OTP_PROVIDER=fake
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
OTP_TTL_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_15MIN=3
OTP_MAX_PER_IP_15MIN=20

# Email (optional)
EMAIL_PROVIDER=fake
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@mineralbridge.com

# Payments / banking / identity / blockchain — leave unset until credentials exist
# PAYMENT_PROVIDER=
# IDENTITY_PROVIDER=
# BLOCKCHAIN_PROVIDER=

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# App
PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Seed (npm run seed) -----------------------------------------------------
SEED_ADMIN_EMAIL=ceo@mineralbridge.co.ke
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
SEED_ADMIN_NAME=Platform CEO
# OTP codes for the seeded admin are sent to this number (fake provider logs them)
SEED_ADMIN_PHONE=+254700000001

# ---- Admin console -----------------------------------------------------------
# Staff must sign in with an address on one of these domains (comma-separated)
STAFF_EMAIL_DOMAINS=mineralbridge.co.ke,mineralbridge.com

# ---- External providers: leave unset and the dependent endpoints answer 503 with a clear code ----
# SSO (OIDC) for admin sign-in -> 503 auth/sso-unconfigured
# SSO_AUTHORIZE_URL=
# SSO_TOKEN_URL=
# SSO_USERINFO_URL=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=
# Bitcoin anchoring of passports/custody batches; anchors stay 'queued' until a worker confirms them
# BLOCKCHAIN_PROVIDER=
# Reference-rate feed for pricing; manual rates keep working without it
# RATE_FEED_PROVIDER=
# E-signature for LC / contracts (default: internal acknowledgement)
# ESIGN_PROVIDER=